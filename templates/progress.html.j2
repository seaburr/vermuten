<!doctype html>

<html>
<head>
    <title>Progress Report</title>
</head>
<link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
<h1>
    Progress Report
</h1>
<h2>
    Riddle Progress: {{ current_riddle_number }} of {{ riddle_count }}
</h2>
<h2>
    Current riddle: {{ current_riddle }}
</h2>
<h2>
    Total number of attempts: {{ attempts }}
</h2>
<div class="center">
    <a href="{{ url_for('progress', game_id=game_id) }}" class="button">Refresh</a>
</div>
<br>
<br>
<div class="center">
    <a href="{{ url_for('reset_admin_page', game_id=game_id) }}" class="button">Restart Game</a>
</div>
</html>
